# Copy this file to local.properties in the project root and edit the values.
# This file is a template only; do not commit the populated local.properties.

# Android SDK location for this machine. Use forward slashes on Windows.
# sdk.dir=<ANDROID_SDK_PATH>

# Optional deployment-specific WebSocket video endpoints.
# Leave unset for normal public development builds.
# The app accepts a comma-separated list when configured.
# ws.server.urls=ws://<BACKEND_HOST>:8080

# Keep these disabled unless the corresponding external service and contract
# are available in the deployment environment.
resident.identity.enabled=false
care.report.enabled=false

# Legacy global MQTT action topics are disabled by default.
# Enable only for a controlled LAB deployment that still requires
# temi/action/speak, temi/action/navigate, and temi/action/wakeup.
legacy.mqtt.actions.enabled=false

# MQTT host, port, robot ID, and broker credentials are configured privately
# through the app settings/runtime environment; they are not stored here.
